# Copy this file to .env and fill in real values. .env is git-ignored.

# Slack (api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information -> App-Level Tokens (scope: connections:write)
SLACK_ALERT_CHANNEL=#ryanair-alerts
SLACK_MODE=socket                 # socket (local, no ngrok) | http (webhooks)
# SLACK_SIGNING_SECRET=...        # only needed when SLACK_MODE=http

# Use fake data until the real backend is connected
USE_MOCK_BACKEND=true

# LLM (used by backend)
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
